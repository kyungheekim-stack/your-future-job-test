# ─── 참가자 수 표시 (인트로 화면) ────────────────────────────────
# 실제 집계가 아니라 시각 기반 "연출" 카운터다. (lib/participants.ts 주석 참고)
# 셋 다 비우면 00000 으로 고정된다.

# 기준 시점의 누적 참가자 수
NEXT_PUBLIC_PARTICIPANT_COUNT=1240

# 위 숫자가 정확했던 시각 (ISO 8601). 비면 증가하지 않는다.
NEXT_PUBLIC_PARTICIPANT_EPOCH=2026-08-28T00:00:00+09:00

# 시간당 증가 수. 예) 12 = 5분에 1명씩
NEXT_PUBLIC_PARTICIPANT_PER_HOUR=12

# ─── 외부 링크 ──────────────────────────────────────────────
# 좌상단 로고를 눌렀을 때 가는 곳
NEXT_PUBLIC_LANDING_URL=https://socratutor.ai/landing

# 「SOCRA Tutorに登録する」 가 가는 곳.
# 비워 두면 이동하지 않고 그 자리에서 상세를 펼친다 (프리뷰에서 화면 확인용).
NEXT_PUBLIC_REGISTER_URL=https://socratutor.ai/onboarding/register/phone?returnUrl=%2Fchat
